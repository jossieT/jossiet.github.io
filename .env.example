# ============================================================================
# Yosef Portfolio — Environment Configuration (example)
#
# Copy this file to `.env` and adjust values for your local environment:
#   cp .env.example .env
#
# NEVER commit the real `.env` file. It contains secrets.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=Yosef Portfolio API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (local dev values; override in production) --------------------
DATABASE_URL=postgresql+psycopg://yosef:yosef_dev_password@localhost:5432/yosef_portfolio
POSTGRES_DB=yosef_portfolio
POSTGRES_USER=yosef
POSTGRES_PASSWORD=yosef_dev_password

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
