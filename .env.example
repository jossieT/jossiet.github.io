# ============================================================================
# Yosef Portfolio — Environment Configuration (example)
#
# Copy this file to `.env` and adjust values for your local environment:
#   cp .env.example .env
#
# NEVER commit the real `.env` file. It contains secrets.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=Yosef Portfolio API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 17 on host port 5433) -----------------------------
DATABASE_URL=postgresql+psycopg://yosef:yosef_dev_password@localhost:5433/yosef_portfolio
POSTGRES_DB=yosef_portfolio
POSTGRES_USER=yosef
POSTGRES_PASSWORD=yosef_dev_password

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI Portfolio Assistant (Google Gemini) ---------------------------------
# Obtain a free API key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Cost & Abuse Protection
AI_MAX_INPUT_LENGTH=2000
AI_MAX_HISTORY_MESSAGES=10
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_HOUR=20
AI_CONTEXT_CACHE_TTL=300
